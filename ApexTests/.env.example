# Base URL for the ApexApp dev server
BASE_URL=http://localhost:3000

# API server URL (used by global-setup and api-helpers to make direct API calls)
API_URL=https://acme.localhost:5000

# Admin credentials (seeded by DatabaseSeeder on first run)
TEST_ADMIN_EMAIL=admin@acme.com
TEST_ADMIN_PASSWORD=SecureAdminPass123!

# Manager test user (create manually in User Management)
TEST_MANAGER_EMAIL=manager@acme.com
TEST_MANAGER_PASSWORD=ManagerPass123!

# Standard user (create manually in User Management)
TEST_USER_EMAIL=user@acme.com
TEST_USER_PASSWORD=UserPass123!
